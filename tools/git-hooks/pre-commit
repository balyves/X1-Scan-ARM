#!/bin/bash
# SPDX-License-Identifier: MIT
#
# X1-Scan-ARM pre-commit hook. Blocks a commit whose staged files contain:
#   - a scanner serial number: FX1 followed by 7 digits, as text or as hex
#     bytes ("46 58 31 3x ...", "46583131...", "0x46, 0x58, ...", "\x46\x58...",
#     hexdump -C spacing);
#   - scan, raw or Hasselblad files: *.fff, *.3f, *.raw, *.bit, MICROCOD*, oscode*;
#   - a file larger than 2 MiB.
# Not detected: hex bytes split across two lines, UTF-16 text.
# Known false positive: decimal byte lists such as "46, 58, 31, 32, ...".
# Submodules (gitlinks) are skipped: they are not files of this repository.
#
# Install once per clone:  git config core.hooksPath tools/git-hooks
# Checks the staged version of every staged file except deletions.
# Fails closed: if a check cannot run, the commit is blocked.

set -u
export GIT_LITERAL_PATHSPECS=1  # file names are names, not patterns

max_bytes=$((2 * 1024 * 1024))
serial_text='FX1[0-9]{7}'
separator='[^0-9A-Za-z]{0,4}'
prefix='(0[xX]|\\[xX])?'
serial_hex="(^|[^0-9A-Za-z])${prefix}46${separator}${prefix}58${separator}${prefix}31(${separator}${prefix}3[0-9]){7}"

fail() {
    echo "pre-commit: $1; commit blocked" >&2
    exit 1
}

work=$(mktemp -d) || fail "cannot create a temporary directory"
trap 'rm -rf "$work"' EXIT

# Raw format: ":oldmode newmode oldsha newsha status" NUL path NUL (two paths for renames and copies).
git diff --cached --raw -z --diff-filter=d > "$work/raw" 2> "$work/errors" \
    || fail "cannot list staged files ($(head -n 1 "$work/errors"))"
[ -s "$work/raw" ] || exit 0

problems=0
report() {
    echo "pre-commit: $1" >&2
    problems=$((problems + 1))
}

paths=()
: > "$work/paths"
while IFS= read -r -d '' header; do
    mode=${header#* }; mode=${mode%% *}
    status=${header##* }
    case "$status" in
        R*|C*) IFS= read -r -d '' path || fail "cannot parse staged file list" ;;  # source path, not checked
    esac
    IFS= read -r -d '' path || fail "cannot parse staged file list"
    [ "$mode" = 160000 ] && continue  # submodule
    paths+=("$path")
    printf '%s\0' "$path" >> "$work/paths"
done < "$work/raw"
[ ${#paths[@]} -gt 0 ] || exit 0

# 1. File names.
for path in "${paths[@]}"; do
    name=${path##*/}
    case "$name" in
        *.[fF][fF][fF]|*.3[fF]|*.[rR][aA][wW]|*.[bB][iI][tT])
            report "forbidden file type: $path" ;;
        [mM][iI][cC][rR][oO][cC][oO][dD]*|[oO][sS][cC][oO][dD][eE]*)
            report "Hasselblad firmware name: $path" ;;
    esac
done

# 2. Sizes of the staged blobs, in one git call (":0:" = stage 0, so names
#    such as "0:x" are not misread). Names containing a newline are checked one by one.
check_size() {
    case "$2" in
        ''|*[!0-9]*) fail "cannot read the staged file $1" ;;
    esac
    if [ "$2" -gt "$max_bytes" ]; then
        report "file larger than 2 MiB ($2 bytes): $1"
    fi
}
batch=()
for path in "${paths[@]}"; do
    case "$path" in
        *$'\n'*) check_size "$path" "$(git cat-file -s ":0:$path" 2>/dev/null)" ;;
        *) batch+=("$path") ;;
    esac
done
if [ ${#batch[@]} -gt 0 ]; then
    printf ':0:%s\n' "${batch[@]}" | git cat-file --batch-check='%(objectsize)' > "$work/sizes" \
        || fail "cannot read staged file sizes"
    index=0
    while IFS= read -r size; do
        [ "$index" -lt ${#batch[@]} ] || fail "unexpected output while reading sizes"
        check_size "${batch[$index]}" "$size"
        index=$((index + 1))
    done < "$work/sizes"
    [ "$index" -eq ${#batch[@]} ] || fail "cannot read staged file sizes"
fi

# 3. Serial numbers in the staged contents, binary files included (-a).
#    git grep exits 1 when nothing matches, so errors are detected on stderr.
xargs -0 git grep --cached -a -l -z -E -e "$serial_text" -e "$serial_hex" -- \
    < "$work/paths" > "$work/hits" 2> "$work/errors"
if [ -s "$work/errors" ]; then
    cat "$work/errors" >&2
    fail "cannot search the staged files"
fi
while IFS= read -r -d '' path; do
    report "possible scanner serial number (FX1 + 7 digits) in: $path"
done < "$work/hits"

if [ "$problems" -gt 0 ]; then
    echo "pre-commit: commit blocked ($problems problem(s)). Use FX1xxxxxxx for serial numbers;" >&2
    echo "pre-commit: keep scans, captures and firmware outside the repository." >&2
    exit 1
fi
exit 0
