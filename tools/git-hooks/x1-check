#!/bin/bash
# SPDX-License-Identifier: MIT
#
# X1-Scan-ARM content checks, shared by the git hooks and the CI.
#
#   x1-check --staged            files staged for commit          (pre-commit hook)
#   x1-check --message FILE      a commit message, "-" for stdin  (commit-msg hook)
#   x1-check --commit SHA        files changed by one commit, and its message
#   x1-check --range BASE HEAD   every commit in BASE..HEAD (CI); every commit up
#                                to HEAD if BASE is empty, all zeros or unknown
#
# Blocks:
#   - a scanner serial number, FX1 + 7 digits in any case, as text or as hex
#     bytes ("46 58 31 3x ...", "46583131...", "0x46, 0x58, ...", "\x46\x58...",
#     hexdump -C spacing), in file contents, file names and commit messages;
#   - scan, image, raw or Hasselblad files, in any case: *.fff, *.3f, *.3fr, *.raw,
#     *.tif, *.tiff, *.bit, *.dtp, *.a3, MICROCOD*, oscode*, osloader*;
#   - files larger than 2 MiB.
# Not detected: hex bytes split across two lines, UTF-16 text, hex glued to a
# preceding letter or digit. Known false positive: decimal byte lists such as
# "46, 58, 31, 32, ...". Submodules (gitlinks) are skipped.
# Fails closed: if a check cannot run, the result is a failure.

set -u
export GIT_LITERAL_PATHSPECS=1  # file names are names, not patterns
shopt -s nocasematch            # case-insensitive `case` and [[ =~ ]]

max_bytes=$((2 * 1024 * 1024))
serial_text='FX1[0-9]{7}'
separator='[^0-9A-Za-z]{0,4}'
prefix='(0[xX]|\\[xX])?'
serial_hex="(^|[^0-9A-Za-z])${prefix}46${separator}${prefix}58${separator}${prefix}31(${separator}${prefix}3[0-9]){7}"
serial_any="${serial_text}|${serial_hex}"

problems=0

fail() {
    echo "x1-check: $1; blocked" >&2
    exit 1
}

report() {
    echo "x1-check: $1" >&2
    problems=$((problems + 1))
}

usage() {
    sed -n '6,10p' "$0" >&2
    exit 2
}

work=$(mktemp -d) || fail "cannot create a temporary directory"
trap 'rm -rf "$work"' EXIT

# check_files RAW BLOB SOURCE LABEL
#   RAW: output of `git diff --raw -z` / `git diff-tree --raw -z`
#   BLOB: prefix that turns a path into a blob name (":0:" for the index, "<sha>:")
#   SOURCE: "--cached" for the index, or the commit SHA
#   LABEL: appended to messages
check_files() {
    local raw=$1 blob=$2 source=$3 label=$4
    local header mode status path name size index
    local paths=() batch=()

    : > "$work/paths"
    while IFS= read -r -d '' header; do
        mode=${header#* }; mode=${mode%% *}
        status=${header##* }
        case "$status" in
            R*|C*) IFS= read -r -d '' path || fail "cannot parse the file list" ;;  # source path, not checked
        esac
        IFS= read -r -d '' path || fail "cannot parse the file list"
        [ "$mode" = 160000 ] && continue  # submodule
        paths+=("$path")
        printf '%s\0' "$path" >> "$work/paths"
    done < "$raw"
    [ ${#paths[@]} -gt 0 ] || return 0

    # 1. File names.
    for path in "${paths[@]}"; do
        name=${path##*/}
        case "$name" in
            *.fff|*.3f|*.3fr|*.raw|*.tif|*.tiff|*.bit|*.dtp|*.a3)
                report "forbidden file type: $path$label" ;;
            microcod*|oscode*|osloader*)
                report "Hasselblad firmware name: $path$label" ;;
        esac
        if [[ $path =~ $serial_any ]]; then
            report "possible scanner serial number in the file name: $path$label"
        fi
    done

    # 2. Sizes, in one git call. Names containing a newline are read one by one.
    for path in "${paths[@]}"; do
        case "$path" in
            *$'\n'*) check_size "$path" "$(git cat-file -s "$blob$path" 2>/dev/null)" "$label" ;;
            *) batch+=("$path") ;;
        esac
    done
    if [ ${#batch[@]} -gt 0 ]; then
        printf '%s\n' "${batch[@]/#/$blob}" | git cat-file --batch-check='%(objectsize)' > "$work/sizes" \
            || fail "cannot read file sizes"
        index=0
        while IFS= read -r size; do
            [ "$index" -lt ${#batch[@]} ] || fail "unexpected output while reading sizes"
            check_size "${batch[$index]}" "$size" "$label"
            index=$((index + 1))
        done < "$work/sizes"
        [ "$index" -eq ${#batch[@]} ] || fail "cannot read file sizes"
    fi

    # 3. Contents, binary files included (-a). git grep exits 1 when nothing
    #    matches, so errors are detected on stderr.
    if [ "$source" = --cached ]; then
        xargs -0 git grep --cached -a -l -z -i -E -e "$serial_text" -e "$serial_hex" -- \
            < "$work/paths" > "$work/hits" 2> "$work/errors"
    else
        xargs -0 git grep -a -l -z -i -E -e "$serial_text" -e "$serial_hex" "$source" -- \
            < "$work/paths" > "$work/hits" 2> "$work/errors"
    fi
    if [ -s "$work/errors" ]; then
        cat "$work/errors" >&2
        fail "cannot search the files"
    fi
    while IFS= read -r -d '' path; do
        [ "$source" = --cached ] || path=${path#"$source:"}
        report "possible scanner serial number in: $path$label"
    done < "$work/hits"
}

check_size() {  # PATH SIZE LABEL
    case "$2" in
        ''|*[!0-9]*) fail "cannot read the file $1$3" ;;
    esac
    if [ "$2" -gt "$max_bytes" ]; then
        report "file larger than 2 MiB ($2 bytes): $1$3"
    fi
}

check_message() {  # FILE LABEL
    # The whole message, '#' lines included: `git commit -m` keeps them.
    if LC_ALL=C grep -a -i -q -E "$serial_any" "$1"; then
        report "possible scanner serial number in $2"
    fi
}

# For the commit-msg hook only: drop what `git commit -v` appends below git's
# scissors line, which git removes before recording the commit. Cut only when
# the scissors line is followed by git's own warning line; otherwise the text
# is part of the message and is checked. Recorded messages (--commit, --range)
# are never cut.
cut_verbose_diff() {  # FILE
    LC_ALL=C awk '
        { line[NR] = $0 }
        END {
            cut = NR + 1
            for (i = 1; i < NR; i++) {
                if (line[i] ~ /^[^ ]* -------------------------* >8 -------------------------*$/ &&
                    line[i + 1] ~ /^[^ ]* Do not modify or remove the line above\.$/) { cut = i; break }
            }
            for (i = 1; i < cut; i++) print line[i]
        }' "$1"
}

# Run from the top of the work tree: git diff paths are relative to it,
# git grep pathspecs to the current directory.
go_to_top() {
    local top
    top=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a git work tree"
    cd "$top" || fail "cannot enter $top"
}

check_commit() {  # SHA
    local sha
    sha=$(git rev-parse --verify --quiet "$1^{commit}") || fail "unknown commit $1"
    if git rev-parse --verify --quiet "$sha^2" > /dev/null; then
        # Merge: compare with the first parent, so that content added by the merge
        # itself (conflict resolution, merge --no-commit) is checked too.
        git diff --raw -z --diff-filter=d "$sha^1" "$sha" > "$work/raw" 2> "$work/errors" \
            || fail "cannot list the files of merge $sha ($(head -n 1 "$work/errors"))"
    else
        git diff-tree -r --root --raw -z --diff-filter=d --no-commit-id "$sha" > "$work/raw" 2> "$work/errors" \
            || fail "cannot list the files of commit $sha ($(head -n 1 "$work/errors"))"
    fi
    check_files "$work/raw" "$sha:" "$sha" " (commit ${sha:0:12})"
    git log -1 --format=%B "$sha" > "$work/message" || fail "cannot read the message of commit $sha"
    check_message "$work/message" "the message of commit ${sha:0:12}"
}

case "${1:-}" in
    --staged)
        [ $# -eq 1 ] || usage
        go_to_top
        git diff --cached --raw -z --diff-filter=d > "$work/raw" 2> "$work/errors" \
            || fail "cannot list staged files ($(head -n 1 "$work/errors"))"
        check_files "$work/raw" ":0:" --cached ""
        ;;
    --message)
        [ $# -eq 2 ] || usage
        if [ "$2" = - ]; then
            cat > "$work/message.full" || fail "cannot read the message"
        else
            cp "$2" "$work/message.full" || fail "cannot read the message"
        fi
        cut_verbose_diff "$work/message.full" > "$work/message" || fail "cannot read the message"
        check_message "$work/message" "the commit message"
        ;;
    --commit)
        [ $# -eq 2 ] || usage
        go_to_top
        check_commit "$2"
        ;;
    --range)
        [ $# -eq 3 ] || usage
        go_to_top
        head_sha=$(git rev-parse --verify --quiet "$3^{commit}") || fail "unknown commit $3"
        if [ -n "$2" ] && base=$(git rev-parse --verify --quiet "$2^{commit}"); then
            git rev-list --reverse "$base..$head_sha" > "$work/commits" || fail "cannot list commits"
        else
            echo "x1-check: base '$2' not found, checking every commit up to $head_sha" >&2
            git rev-list --reverse "$head_sha" > "$work/commits" || fail "cannot list commits"
        fi
        count=0
        while IFS= read -r sha <&3; do
            check_commit "$sha"
            count=$((count + 1))
        done 3< "$work/commits"
        echo "x1-check: $count commit(s) checked"
        ;;
    *)
        usage
        ;;
esac

if [ "$problems" -gt 0 ]; then
    echo "x1-check: $problems problem(s). Use FX1xxxxxxx for serial numbers;" >&2
    echo "x1-check: keep scans, captures and firmware outside the repository." >&2
    exit 1
fi
exit 0
