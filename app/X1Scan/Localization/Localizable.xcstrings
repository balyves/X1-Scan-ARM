    "issue.capture-missing.cause": {
      "comment": "Error message capture-missing: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference sequences built into the application are missing or unreadable. Nothing was sent to the scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séquences de référence intégrées à l’application sont absentes ou illisibles. Rien n’a été envoyé au scanner."
          }
