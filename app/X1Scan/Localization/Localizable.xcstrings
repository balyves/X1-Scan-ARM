    "issue.scanner-timeout.step2": {
      "comment": "Error message scanner-timeout: step 2 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 off, then on again, before starting again."
          }
        },
        "fr": {
