      }
    },
    "FlexColor's captured preview will be sent to the scanner, command for command. Any difference stops it; Stop (⌘. or Esc) stays available. Every command is logged.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu capturé de FlexColor sera envoyé au scanner, commande par commande. Toute différence l'arrête ; Arrêter (⌘. ou Échap) reste disponible. Chaque commande est journalisée."
          }
        }
      }
    },
    "The X1 is on": {
