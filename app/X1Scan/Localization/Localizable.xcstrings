    "settings.launchPresenceNote": {
      "comment": "Settings > Scanner note under Source at launch: the presence check (nothing opened or sent)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At launch, with the real X1 as the source, X1 Scan only looks whether an X1 is connected, without reading it: use Scanner > Read Identity."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lancement, avec le X1 réel comme source, X1 Scan regarde seulement si un X1 est branché, sans le lire : utilisez Scanner › Lire l'identité."
          }
        }
      }
    },
    "Drag to resize the settings panel, or to the right to hide it; drag it back to the left to show it again": {
      "comment": "Tooltip of the line between the image and the tool column; the app adds its shortcut in parentheses",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
