    "issue.no-scanner.title": {
      "comment": "Error message no-scanner: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No X1 found"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun X1 trouvé"
          }
        }
      }
    },
    "issue.no-scanner.cause": {
      "comment": "Error message no-scanner: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac sees no Flextight scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac ne voit aucun scanner Flextight."
          }
        }
      }
    },
    "issue.no-scanner.step1": {
      "comment": "Error message no-scanner: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that the X1 is on and that its FireWire cable and adapters are connected."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le X1 est allumé, et que son câble FireWire et ses adaptateurs sont branchés."
          }
        }
      }
    },
    "issue.no-scanner.step2": {
      "comment": "Error message no-scanner: step 2 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On macOS 26, check that the ASFireWire driver is installed and allowed in System Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur macOS 26, vérifiez que le pilote ASFireWire est installé et autorisé dans Réglages Système."
          }
        }
      }
    },
    "issue.no-scanner.step3": {
      "comment": "Error message no-scanner: step 3 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the cable comes from another Mac: X1 off, then on again, and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le câble vient d’un autre Mac : X1 éteint, puis rallumé, et réessayez."
          }
        }
      }
    },
    "issue.scanner-busy.title": {
      "comment": "Error message scanner-busy: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X1 is busy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le X1 est occupé"
          }
        }
      }
    },
    "issue.scanner-busy.cause": {
      "comment": "Error message scanner-busy: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another program already has the scanner open, probably FlexColor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre programme a déjà ouvert le scanner, probablement FlexColor."
          }
        }
      }
    },
    "issue.scanner-busy.step1": {
      "comment": "Error message scanner-busy: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit FlexColor, or the other program that uses the X1. The X1 can stay on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez FlexColor, ou l’autre programme qui utilise le X1. Le X1 peut rester allumé."
          }
        }
      }
    },
    "issue.scanner-busy.step2": {
      "comment": "Error message scanner-busy: step 2 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez."
          }
        }
      }
    },
    "issue.not-an-x1.title": {
      "comment": "Error message not-an-x1: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This scanner is not an X1"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce scanner n’est pas un X1"
          }
        }
      }
    },
    "issue.not-an-x1.cause": {
      "comment": "Error message not-an-x1: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanner found is not a Flextight X1. Nothing more was sent to it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner trouvé n’est pas un Flextight X1. Rien d’autre ne lui a été envoyé."
          }
        }
      }
    },
    "issue.not-an-x1.step1": {
      "comment": "Error message not-an-x1: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 Scan works with the Flextight X1 only. Connect an X1, or use another program for this scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 Scan ne fonctionne qu’avec le Flextight X1. Branchez un X1, ou utilisez un autre programme pour ce scanner."
          }
        }
      }
    },
    "issue.scanner-read-failed.title": {
      "comment": "Error message scanner-read-failed: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X1 could not be read"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le X1 n’a pas pu être lu"
          }
        }
      }
    },
    "issue.scanner-read-failed.cause": {
      "comment": "Error message scanner-read-failed: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanner could not be opened, or it answered differently from what is known."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner n’a pas pu être ouvert, ou il a répondu autrement que prévu."
          }
        }
      }
    },
    "issue.scanner-read-failed.step1": {
      "comment": "Error message scanner-read-failed: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 off, then on again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 éteint, puis rallumé."
          }
        }
      }
    },
    "issue.scanner-read-failed.step2": {
      "comment": "Error message scanner-read-failed: step 2 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If it happens again, copy the details for a bug report."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez. Si cela se reproduit, copiez les détails pour un rapport de bug."
          }
        }
      }
    },
    "issue.disconnected.title": {
      "comment": "Error message disconnected: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X1 no longer answers"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le X1 ne répond plus"
          }
        }
      }
    },
    "issue.disconnected.cause": {
      "comment": "Error message disconnected: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanner was disconnected or switched off during the operation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scanner a été débranché ou éteint pendant l’opération."
          }
        }
      }
    },
    "issue.disconnected.step1": {
      "comment": "Error message disconnected: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the cable, the adapters and the X1’s power."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le câble, les adaptateurs et l’alimentation du X1."
          }
        }
      }
    },
    "issue.disconnected.step2": {
      "comment": "Error message disconnected: step 2 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 off, then on again, before starting again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 éteint, puis rallumé, avant de recommencer."
          }
        }
      }
    },
    "issue.scanner-timeout.title": {
      "comment": "Error message scanner-timeout: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X1 did not answer in time"
          }
