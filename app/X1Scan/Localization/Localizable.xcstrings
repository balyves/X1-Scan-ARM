          "stringUnit": {
            "state": "translated",
            "value": "Check the FireWire cable and the adapters."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le câble FireWire et les adaptateurs."
          }
        }
