    "discovery.noScanner.details": {
      "comment": "Details of the No X1 found message after the presence check (at launch, or on leaving discovery mode): what was done",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Presence check: no Imacon or Hasselblad device in the I/O Registry. Nothing was opened or sent to a scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de présence : aucun appareil Imacon ou Hasselblad dans le registre des appareils. Rien n’a été ouvert ni envoyé à un scanner."
          }
        }
      }
    },
    "Read Identity is in Scanner > Scanner Information (%@); the state is in the bottom bar.": {
      "comment": "Settings > Scanner note; %@ is the shortcut of Scanner Information (⌘I), from the shortcuts' own source",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read Identity is in Scanner > Scanner Information (%@); the state is in the bottom bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Lire l'identité » est dans Scanner › Informations sur le scanner (%@) ; l'état est dans la barre du bas."
          }
        }
      }
    },
    "discovery.sourceNote": {
      "comment": "Settings > Scanner note under the Source menu, disabled in discovery mode",
      "extractionState": "manual",
      "localizations": {
