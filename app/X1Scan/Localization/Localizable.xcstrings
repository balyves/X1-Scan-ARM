        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Film, porte-film, orientation et cadrage"
          }
        }
      }
    },
    "Fine rotation of the image in degrees; in crop mode the arrows go to the next whole degree, to the next multiple of 5° with Shift": {
      "comment": "Tooltip of the Angle slider and field; the app adds the arrow keys in parentheses",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine rotation of the image in degrees; in crop mode the arrows go to the next whole degree, to the next multiple of 5° with Shift"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotation fine de l’image en degrés ; en mode Recadrage, les flèches vont au degré entier suivant, au multiple de 5° suivant avec Maj"
          }
        }
      }
    },
