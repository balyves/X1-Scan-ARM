    "issue.position-out-of-range.title": {
      "comment": "Error message position-out-of-range: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped by a safety check: position out of range"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêt par un garde-fou : position hors plage"
          }
        }
      }
    },
    "issue.position-out-of-range.cause": {
      "comment": "Error message position-out-of-range: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before focusing, the position read was outside the validated range. The scan stopped before that step, on purpose, to protect the scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant la mise au point, la position lue sortait de la plage validée. La numérisation s’est arrêtée avant cette étape, exprès, pour protéger le scanner."
          }
        }
      }
    },
    "issue.position-out-of-range.step1": {
      "comment": "Error message position-out-of-range: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the X1 has been switched off and on, run a complete preview without touching the holder, then scan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir éteint puis rallumé le X1, faites un aperçu complet sans toucher au porte-film, puis numérisez."
          }
        }
      }
    },
    "issue.carriage-position.title": {
      "comment": "Error message carriage-position: short title, what happened",
