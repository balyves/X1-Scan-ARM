    "issue.start-state-unknown.cause": {
      "comment": "Error message start-state-unknown: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The X1 showed neither its state right after power-on nor the state left by earlier use. X1 Scan stopped to protect it: only reads, the startup command and the session start were sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le X1 n’a montré ni son état juste après l’allumage, ni l’état laissé par un usage précédent. X1 Scan s’est arrêté pour le protéger : seules des lectures, la commande de démarrage et le début de session ont été envoyées."
          }
        }
      }
    },
    "issue.start-state-unknown.step1": {
      "comment": "Error message start-state-unknown: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
