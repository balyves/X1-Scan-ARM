    "issue.log-failed.cause": {
      "comment": "Error message log-failed: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every command sent to the real X1 is written to a log. Without a log, nothing is sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque commande envoyée au X1 réel est écrite dans un journal. Sans journal, rien n’est envoyé."
          }
        }
      }
    },
