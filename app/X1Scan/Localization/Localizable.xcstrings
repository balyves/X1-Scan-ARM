{
  "sourceLanguage": "en",
  "strings": {
    "%@ inches": {
      "comment": "VoiceOver: an opening in inches, e.g. “2.24 × 2.76 inches”",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pouces"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inches"
          }
        }
      }
    },
    "%@ millimetres, %@ inches": {
      "comment": "VoiceOver: a holder opening, e.g. “57 × 70 millimetres, 2¼ × 2.76 inches”",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ millimètres, %2$@ pouces"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ millimetres, %2$@ inches"
          }
        }
      }
    },
    "%@ is missing from the application.": {
      "comment": "About panel: a licence file was not found; %@ is its name",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ manque dans l’application."
          }
        }
      }
    },
    "Choose the folder where Export writes the files.": {
      "comment": "Tooltip of the Choose… button of the Folder row",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder where Export writes the files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le dossier où Exporter enregistre les fichiers."
          }
        }
      }
    },
    "Click: show or hide · Right click: kind, colour, opacity": {
      "comment": "Tooltip of the Grid button of the tool column; the app adds its shortcut in parentheses",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click: show or hide · Right click: kind, colour, opacity"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clic : afficher ou masquer · Clic droit : type, couleur, opacité"
          }
        }
      }
    },
    "Code licence (MIT)": {
      "comment": "About panel: heading above the MIT licence text",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Licence du code (MIT)"
          }
        }
      }
    },
    "Colour and opacity of the grid lines; display only.": {
      "comment": "Tooltip of the Tint label of the Framing section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour and opacity of the grid lines; display only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur et opacité des lignes de la grille ; affichage seulement."
          }
        }
      }
    },
    "Colour of the grid lines, on the image and in the crop frame; display only.": {
      "comment": "Tooltip of the grid colour menu of the Framing section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colour of the grid lines, on the image and in the crop frame; display only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur des lignes de la grille, sur l’image et dans le cadre ; affichage seulement."
          }
        }
      }
    },
    "Crop: draw and adjust the frame, in Prepare › Framing": {
      "comment": "Tooltip of the Crop tool; the app adds its shortcut in parentheses",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crop: draw and adjust the frame, in Prepare › Framing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadrage : tracer et ajuster le cadre, dans Préparer › Cadrage"
          }
        }
      }
    },
    "Develop Tab": {
      "comment": "View menu item (not shown yet)",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Develop Tab"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onglet Développer"
          }
        }
      }
    },
    "Export the image shown, turned, straightened and cropped, with its recipe. A saved scan is never replaced: its versions are named _v1, _v2…": {
      "comment": "Tooltip of the panel's Export button; the app adds its shortcut in parentheses",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the image shown, turned, straightened and cropped, with its recipe. A saved scan is never replaced: its versions are named _v1, _v2…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter l’image affichée, tournée, redressée et recadrée, avec sa recette. Un scan enregistré n’est jamais remplacé : ses versions sont nommées _v1, _v2…"
          }
        }
      }
    },
    "Exposure Zones": {
      "comment": "Tool column button: clipped and noise zones over the preview",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposure Zones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zones d’exposition"
          }
        }
      }
    },
    "Film holder in the scanner; saved, applied to the scanner with real scans later.": {
      "comment": "Tooltip of the Holder menu of the settings panel",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film holder in the scanner; saved, applied to the scanner with real scans later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Porte-film dans le scanner ; enregistré, appliqué au scanner lors des numérisations réelles, plus tard."
          }
        }
      }
    },
    "Film, holder, orientation and framing": {
      "comment": "Tooltip of the Prepare tab of the settings panel",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Film, holder, orientation and framing"
