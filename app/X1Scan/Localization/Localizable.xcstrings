    "issue.guard-refused.cause": {
      "comment": "Error message guard-refused: the likely cause, one sentence",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A command did not match the validated sequence. The safety check blocked it before it was sent, to protect the scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une commande ne correspondait pas à la séquence validée. Le garde-fou l’a bloquée avant l’envoi, pour protéger le scanner."
          }
        }
      }
    },
