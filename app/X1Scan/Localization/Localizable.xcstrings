      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The carriage was not where it was expected. The preview stopped before the carriage was positioned, on purpose, to protect the scanner."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chariot n’était pas à la position attendue. L’aperçu s’est arrêté avant de positionner le chariot, exprès, pour protéger le scanner."
          }
        }
      }
    },
    "issue.carriage-position.step1": {
      "comment": "Error message carriage-position: step 1 of what to do",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 off, then on again, before starting the preview again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "X1 éteint, puis rallumé, avant de relancer l’aperçu."
          }
        }
      }
    },
    "issue.start-state-unknown.title": {
      "comment": "Error message start-state-unknown: short title, what happened",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped by a safety check: unknown starting state"
